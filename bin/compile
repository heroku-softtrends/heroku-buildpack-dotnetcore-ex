#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>

### Configure environment

set -o errexit    # always exit on error
set -o pipefail   # don't ignore exit codes when piping output
set -o nounset    # fail on unset variables
unset GIT_DIR     # Avoid GIT_DIR leak from previous build steps
	
### Constants

### Configure directories
BUILD_DIR=${1:-}
# shellcheck disable=SC2034  # used by apt_install() in bin/util/apt_dpkg_install.sh
CACHE_DIR=${2:-}
ENV_DIR=${3:-}
BP_DIR=$(cd "$(dirname "${0:-}")" || exit 1; cd ..; pwd)

### Load dependencies

# shellcheck source=util/common.sh
source "$BP_DIR/bin/util/common.sh"
# shellcheck source=util/apt_dpkg_install.sh
source "$BP_DIR/bin/util/apt_dpkg_install.sh" 

export_env_dir "$ENV_DIR"

### Local variable declaration
declare herokuos_version framework_version project_dir file_based_app

# Get OS
herokuos_version="$(get_linux_platform_version)"

print "OS: Ubuntu $herokuos_version"
print "Stack version: ${STACK:-unknown}"

print "Installing prerequisites for .NET Core on Ubuntu"
# Package names below follow the Microsoft .NET runtime dependency list
# (https://learn.microsoft.com/dotnet/core/install/linux-ubuntu) for the
# corresponding Ubuntu base image of each Heroku stack:
#   heroku-16 (16.04, EOL)         heroku-20 (20.04, EOL)
#   heroku-18 (18.04, EOL)         heroku-22 (22.04, deprecated)
#                                  heroku-24 (24.04, default stack)
#                                  heroku-26 (26.04, current)
if [[ $herokuos_version == "16.04" ]]; then
	apt_install ca-certificates libc6 libgcc1 libgssapi-krb5-2 libicu55 libssl1.0.0 libstdc++6 zlib1g
elif [[ $herokuos_version == "18.04" ]]; then
	apt_install ca-certificates libc6 libgcc1 libgssapi-krb5-2 libicu60 libssl1.1 libstdc++6 zlib1g
elif [[ $herokuos_version == "20.04" ]]; then
   	apt_install apt-transport-https ca-certificates libc6 libgcc-s1 libgssapi-krb5-2 libicu66 libssl1.1 libstdc++6 zlib1g
elif [[ $herokuos_version == "22.04" ]]; then
   	apt_install apt-transport-https ca-certificates libc6 libgcc-s1 libgssapi-krb5-2 libicu70 liblttng-ust1 libssl3 libstdc++6 libunwind8 zlib1g
elif [[ $herokuos_version == "24.04" ]]; then
	# Ubuntu 24.04 renamed libssl3 to libssl3t64 as part of the 64-bit time_t transition.
   	apt_install ca-certificates libc6 libgcc-s1 libgssapi-krb5-2 libicu74 libssl3t64 libstdc++6 tzdata zlib1g
elif [[ $herokuos_version == "26.04" ]]; then
   	apt_install ca-certificates libbrotli1 libc6 libgcc-s1 libgssapi-krb5-2 libicu78 libssl3t64 libstdc++6 tzdata zlib1g
else
	error <<-EOF
		Unsupported Ubuntu version: ${herokuos_version}

		This buildpack supports Heroku stacks heroku-16 through heroku-26
		(Ubuntu 16.04, 18.04, 20.04, 22.04, 24.04 and 26.04). Check your
		app's stack with 'heroku stack' and see
		https://devcenter.heroku.com/articles/stack for current stack
		support.
	EOF
fi

# Skip TELEMETRY_OPTOUT on production environment
export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=${DOTNET_SKIP_FIRST_TIME_EXPERIENCE:-1}
export DOTNET_CLI_TELEMETRY_OPTOUT=${DOTNET_CLI_TELEMETRY_OPTOUT:-1}
export ASPNETCORE_ENVIRONMENT=${ASPNETCORE_ENVIRONMENT:-production}

# Validate that a usable .NET project or file-based app exists before
# attempting any install. bin/test-compile (and anyone else) can invoke this
# script directly without going through bin/detect first, so this check has
# to stand on its own rather than assume detect already ran.
project_dir="$(get_first_csproj_dir "$BUILD_DIR")"
if [[ -z $project_dir ]]; then
	file_based_app="$(get_file_based_app_file "$BUILD_DIR")"
fi
if [[ -z $project_dir && -z $file_based_app ]]; then
	error <<-EOF
		No .NET solution, project (.csproj, .fsproj, .vbproj) or file-based
		app (.cs) was found within ${BUILD_DIR} (searched the build
		directory root and one level of subdirectories).

		An ASP.NET Core app requires a project file at the root of the
		directory structure (for a single-project app), a .sln/.slnx file
		that references a project within one subdirectory (for a
		solution-based app), or a standalone .cs file at the root (for a
		file-based app).
	EOF
fi

# Get netcore framework version. File-based apps have no project file to
# read <TargetFramework> from, so there's nothing to resolve here for them
# — the SDK install step below omits --channel in that case and lets
# dotnet-install.sh fall back to its own default channel.
if [[ -n $project_dir ]]; then
	print "The project directory path: ${project_dir}"
	framework_version="$(get_framework_version "$project_dir")"
	if [[ -z $framework_version ]]; then
		error <<-EOF
			Unable to determine the target framework for the project at
			${project_dir}. Ensure its project file declares a <TargetFramework>.
		EOF
	fi
	print "The netcore framework version: ${framework_version}"
else
	framework_version=""
	print "The file-based app: ${file_based_app}"
fi

# Resolve the dotnet SDK version to install. Precedence (most to least specific):
#   1. global.json's "sdk.version"  - the standard .NET SDK pinning mechanism
#   2. productVersion.txt           - this buildpack's own override file
#   3. "Latest" available SDK for the detected channel
#
# Note: a .csproj's <RuntimeFrameworkVersion> is deliberately NOT used here.
# It specifies the .NET *runtime* version, not an SDK version, and
# dotnet-install.sh (called below without --runtime) installs the SDK, so a
# RuntimeFrameworkVersion value (e.g. "6.0.25") is not a valid SDK version to
# pass as --version.
declare -a dotnet_install_args=(--architecture x64 --install-dir "$BUILD_DIR/.dotnet")
if [[ -n $framework_version ]]; then
	dotnet_install_args+=(--channel "$framework_version")
fi

global_json_file="$(get_global_json_file "$BUILD_DIR")"
if [[ -n $global_json_file ]]; then
	print "Found global.json: ${global_json_file}"
	print "The dotnet SDK version will be resolved from global.json"
	dotnet_install_args+=(--jsonfile "$global_json_file")
else
	sdk_version="$(get_specific_version "$BUILD_DIR")"
	if [[ -z $sdk_version ]]; then
		sdk_version="Latest"
	fi
	print "The dotnet SDK version: ${sdk_version} to be installed"
	dotnet_install_args+=(--version "$sdk_version")
fi

# dotnet installation
"$BP_DIR/bin/util/dotnet-install.sh" "${dotnet_install_args[@]}"

# No symlink here on purpose. An earlier version of this script symlinked
# $HOME/.dotnet -> $BUILD_DIR/.dotnet for compile-time PATH access, but
# NuGet opens its own mutex/migration files with O_NOFOLLOW — it refuses
# to traverse a symlink there at all (not just a broken or self-referential
# one) and fails with an ENOTDIR-style error ("NuGet-Migrations" mutex
# creation). Referencing $BUILD_DIR/.dotnet directly for compile-time PATH
# avoids that path ever being a symlink. At runtime this isn't an issue:
# $BUILD_DIR/.dotnet ships as part of the slug and lands at the real,
# non-symlinked $HOME/.dotnet (see .profile.d/dotnetcore.sh below).
export PATH="$PATH:$BUILD_DIR/.dotnet"

## List installed dotnet runtimes
#dotnet --list-runtimes

PROFILE_PATH="$BUILD_DIR/.profile.d/dotnetcore.sh"
mkdir -p "$(dirname "$PROFILE_PATH")"

# Export vars needed at runtime. Only PATH, LD_LIBRARY_PATH and the DOTNET_*
# vars matter once the app is published: the dotnet CLI consults these to
# find its own tools and the native (ICU/OpenSSL/krb5) libraries apt_install
# unpacked into $HOME/.apt. Compiler-only variables (LIBRARY_PATH, CPATH,
# CPPPATH, INCLUDE_PATH) are deliberately NOT carried into the runtime
# environment: dotnet doesn't consult them, and apt_install() in
# bin/util/apt_dpkg_install.sh already exports them for compile-time use.
echo 'export DOTNET_ROOT=$HOME/.dotnet' >> "$PROFILE_PATH"
echo 'export PATH="$PATH:$DOTNET_ROOT:$DOTNET_ROOT/tools:$HOME/.apt/usr/bin"' >> "$PROFILE_PATH"
echo 'export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$HOME/.apt/usr/lib/x86_64-linux-gnu:$HOME/.apt/usr/lib/i386-linux-gnu:$HOME/.apt/usr/lib"' >> "$PROFILE_PATH"
echo "export DOTNET_CLI_TELEMETRY_OPTOUT=1" >> "$PROFILE_PATH"
#echo "export IS_POSTGRES_USED=\"$(is_postgres_used $BUILD_DIR)\"" >> "$PROFILE_PATH"

# Get solution file from build directory
SOLUTION_FILE="$(get_project_sln_file "$BUILD_DIR")"

#print "The nuget packages to be cleared"
dotnet nuget locals all --clear
dotnet --list-runtimes
#dotnet --info

if [[ ${#SOLUTION_FILE} -eq 0 && -n $project_dir ]]; then
	# Get project file from build directory
	PROJECT_FILE="$(get_project_file "$BUILD_DIR")"

	# Get app assembly name from project file
	APP_ASSEMBLY="$(get_project_name "$BUILD_DIR")"
	if [[ -z $APP_ASSEMBLY ]]; then
		error <<-EOF
			Unable to determine the application assembly name from the
			project at ${BUILD_DIR}.
		EOF
	fi
	print "The assembly name: ${APP_ASSEMBLY}"
	echo "export APP_ASSEMBLY=\"${APP_ASSEMBLY}\"" >> "$PROFILE_PATH"

	RELEASE_DIR="${APP_ASSEMBLY}_Release"
	echo "export RELEASE_DIR=\"${APP_ASSEMBLY}_Release\"" >> "$PROFILE_PATH"
	cd "$BUILD_DIR" || exit 1

	# https://docs.microsoft.com/en-us/dotnet/core/tools/dotnet-publish?tabs=netcore21
	# dotnet publish [<PROJECT>]
	dotnet publish "$PROJECT_FILE" -p:PublishDir="$BUILD_DIR/$RELEASE_DIR" --configuration Release --runtime linux-x64 --no-self-contained
elif [[ ${#SOLUTION_FILE} -eq 0 ]]; then
	# File-based app (a bare .cs file, no .csproj at all): the published
	# assembly is conventionally named after the source file.
	APP_ASSEMBLY="$(basename "${file_based_app%.*}")"
	if [[ -z $APP_ASSEMBLY ]]; then
		error <<-EOF
			Unable to determine the application assembly name for the
			file-based app at ${file_based_app}.
		EOF
	fi
	print "The assembly name: ${APP_ASSEMBLY}"
	echo "export APP_ASSEMBLY=\"${APP_ASSEMBLY}\"" >> "$PROFILE_PATH"

	RELEASE_DIR="${APP_ASSEMBLY}_Release"
	echo "export RELEASE_DIR=\"${APP_ASSEMBLY}_Release\"" >> "$PROFILE_PATH"
	cd "$BUILD_DIR" || exit 1

	# dotnet publish of a file-based app: no .csproj involved, the .cs file
	# itself is the publish target.
	dotnet publish "$file_based_app" -p:PublishDir="$BUILD_DIR/$RELEASE_DIR" --configuration Release --runtime linux-x64 --no-self-contained
else
	# Get app assembly name from project file
	APP_ASSEMBLY="$(get_start_project_name "$BUILD_DIR")"
	if [[ -z $APP_ASSEMBLY ]]; then
		error <<-EOF
			Unable to determine a startup project for the solution at
			${BUILD_DIR}. Ensure one of its projects has a
			Properties/launchSettings.json.
		EOF
	fi
	print "The assembly name: ${APP_ASSEMBLY}"
	echo "export APP_ASSEMBLY=\"${APP_ASSEMBLY}\"" >> "$PROFILE_PATH"

	# Get solution name from build directory
	SOLUTION_NAME="$(get_project_sln_name "$BUILD_DIR")"
	print "The solution name: ${SOLUTION_NAME}"

	RELEASE_DIR="${SOLUTION_NAME}_Release"
	echo "export RELEASE_DIR=\"${SOLUTION_NAME}_Release\"" >> "$PROFILE_PATH"
	cd "$BUILD_DIR" || exit 1

	# https://docs.microsoft.com/en-us/dotnet/core/tools/dotnet-publish?tabs=netcore21
	# dotnet publish [<Solution>]
	dotnet publish "$SOLUTION_FILE" -p:PublishDir="$BUILD_DIR/$RELEASE_DIR" --configuration Release --runtime linux-x64 --no-self-contained
fi

# Remove src files in production machine. Skipped for test builds
# (HEROKU_DOTNET_TEST_BUILD, set by bin/test-compile): bin/test needs the
# .csproj/.sln files still present to resolve and run its test command.
if [[ -z "${HEROKU_DOTNET_TEST_BUILD:-}" ]]; then
	find . -maxdepth 1 ! -name Procfile ! -name .profile.d ! -name .apt ! -name .dotnet ! -name .heroku ! -name node_modules ! -name "$RELEASE_DIR" -exec rm -rv {} \; > /dev/null 2>&1;
else
	# Resolve the test command now, while source files are still present,
	# and record it for bin/test to run later. This mirrors the official
	# Heroku .NET buildpack's split: bin/compile decides what "test" means
	# (and writes it down), bin/test just executes what was decided rather
	# than re-discovering it itself.
	test_command="$(resolve_test_command "$BUILD_DIR")"
	if [[ -n $test_command ]]; then
		mkdir -p "$BUILD_DIR/.heroku"
		echo "$test_command" > "$BUILD_DIR/.heroku/test_command"
		print "Recorded test command: ${test_command}"
	fi
fi

if [[ ! -f "$BUILD_DIR/Procfile" && -n "$APP_ASSEMBLY" ]]; then
# Create procfile and Add process type to that
cat << EOT >> "${BUILD_DIR}/Procfile"
	web: cd \$HOME/$RELEASE_DIR && dotnet "./$APP_ASSEMBLY.dll" --urls http://+:\$PORT
EOT
fi
